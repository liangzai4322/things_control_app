  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/ylw/.codex/assistant-conversation-runner/conversation_runner.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/ylw/.codex/assistant-conversation-runner</string>
