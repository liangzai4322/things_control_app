[Unit]
Description=TaskBox attention daily-intake consumer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=taskbox-attention
Group=taskbox-attention
LoadCredential=attention.token:/etc/taskbox-daily-intake/attention.token
Environment=DAILY_INTAKE_API_ENDPOINT=https://liangzai666.com/taskbox-api
Environment=DAILY_INTAKE_TOKEN_FILE=%d/attention.token
RuntimeDirectory=taskbox-attention-daily-intake
StateDirectory=taskbox-attention-daily-intake
ExecStart=/usr/bin/flock -n /run/taskbox-attention-daily-intake/runner.lock /usr/bin/node /opt/taskbox-daily-intake/scripts/consume-daily-intake-attention.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=-/etc/taskbox-daily-intake.disabled
ReadWritePaths=/var/lib/taskbox-attention-daily-intake /run/taskbox-attention-daily-intake

[Install]
WantedBy=multi-user.target
